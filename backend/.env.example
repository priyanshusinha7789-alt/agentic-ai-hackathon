# AgentShield AI Backend Environment Configuration
PROJECT_NAME="AgentShield AI"
VERSION="1.0.0"
API_V1_STR="/api"
DATABASE_URL="agentshield.db"
DEBUG=True

# Google Gemini API Configuration for Dynamic Security Analysis
# Obtain a key from https://aistudio.google.com/
# When set, NovaSupport AI performs dynamic semantic analysis on arbitrary user input.
# If omitted, AgentShield cleanly falls back to deterministic rule-based analysis (RULE_BASED_FALLBACK).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
USE_MOCK_LLM=False
